{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ChatHub",
    "Audience": "ChatHub.Clients",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "storage",
    "MaxFileSizeBytes": 20971520,
    "CleanupIntervalMinutes": 30
  },
  "Https": {
    "RedirectEnabled": true
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RealTime": {
    "HeartbeatIntervalSeconds": 5,
    "InstanceTimeoutSeconds": 15
  },
  "Diagnostics": {
    "ExposeInstanceId": false
  },
  "RateLimiting": {
    "AuthStrictPermitLimit": 10,
    "AuthSessionPermitLimit": 60
  },
  "Caching": {
    "Enabled": true
  }
}
