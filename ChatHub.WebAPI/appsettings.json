{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ChatHub",
    "Audience": "ChatHub.Clients",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "FileStorage": {
    "RootPath": "storage",
    "MaxFileSizeBytes": 20971520,
    "CleanupIntervalMinutes": 30
  },
  "Https": {
    "RedirectEnabled": true
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RealTime": {
    "HeartbeatIntervalSeconds": 5,
    "InstanceTimeoutSeconds": 15
  },
  "Diagnostics": {
    "ExposeInstanceId": false
  },
  "RateLimiting": {
    "AuthStrictPermitLimit": 10,
    "AuthSessionPermitLimit": 60,
    "EmailVerificationPermitLimit": 5,
    "EmailLinkPermitLimit": 30,
    "PasswordResetPermitLimit": 5,
    "UsernameCheckPermitLimit": 30
  },
  "App": {
    "PublicApiBaseUrl": "http://localhost:8080",
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "EmailVerification": {
    "TokenLifetimeHours": 24,
    "MaxRequestsPerHour": 3
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30,
    "MaxRequestsPerHour": 3,
    "MinimumResponseMilliseconds": 300
  },
  "Guest": {
    "Enabled": true,
    "LifetimeHours": 24,
    "MaxActive": 500,
    "CreatePerIpPerHour": 5,
    "CleanupIntervalMinutes": 5
  },
  "Bot": {
    "Enabled": true,
    "ReplyDelayMilliseconds": 1500,
    "MaxRepliesPerConversationPerMinute": 6,
    "PollIntervalMilliseconds": 1000
  },
  "Username": {
    "ChangeCooldownDays": 14
  },
  "Caching": {
    "Enabled": true
  },
  "Messaging": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "BatchSize": 100,
    "PollIntervalMilliseconds": 1000,
    "RetentionDays": 3,
    "CleanupIntervalMinutes": 60,
    "PublishTimeoutSeconds": 15,
    "MaxRetryDelaySeconds": 300,
    "BacklogAlertMinutes": 5
  }
}
