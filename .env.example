# Copy to .env (gitignored, never commit it) and replace every placeholder.
# Secrets must be at least 32 bytes. Generate a fresh one per variable with:
#   openssl rand -base64 48
# The placeholders below are deliberately too short, so the API refuses to start until they are replaced.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL. docker-compose builds ConnectionStrings__DefaultConnection for the migrator and the api from these.
POSTGRES_DB=chathub
POSTGRES_USER=chathub
POSTGRES_PASSWORD=replace-me

# Connection budget: api replicas × DB_MAX_POOL_SIZE + headroom (migrator, seeder, psql) <= POSTGRES_MAX_CONNECTIONS.
# DB_MAX_AUTO_PREPARE=0 turns Npgsql's automatic statement preparation off. See docs/PERFORMANCE.md.
# POSTGRES_MAX_CONNECTIONS=100
# DB_MAX_POOL_SIZE=30
# DB_MAX_AUTO_PREPARE=50

Jwt__Secret=replace-me
FileStorage__SigningKey=replace-me

# Browser origins allowed to call the API. Add more with __1, __2, ...
Cors__AllowedOrigins__0=https://chat.example.com

# docker-compose runs two API replicas behind nginx on a network with a fixed subnet and sets
# ForwardedHeaders__KnownNetworks__0 to that subnet itself, so the API trusts nginx's X-Forwarded-For and the
# per-IP rate limiter sees real client addresses. Change the subnet only if it collides with another Docker network.
# CHATHUB_SUBNET=172.29.0.0/24

# Further reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted. Empty = trust none (loopback only).
# Use the proxy's IP (KnownProxies) or its network in CIDR form (KnownNetworks). Add more with __1, __2, ...
# Under docker-compose KnownNetworks__0 is the compose subnet, so further networks start at __1.
ForwardedHeaders__KnownProxies__0=
ForwardedHeaders__KnownNetworks__1=

# RabbitMQ receives the integration events the api writes to its transactional outbox (see docs/MESSAGING.md).
# docker-compose creates the broker user from these on the first start of an empty chathub-rabbitmq volume and passes
# them to the api as Messaging__User / Messaging__Password; changing them later needs `docker compose down -v` or rabbitmqctl.
# Defaults: chathub / chathub. Management UI: http://127.0.0.1:15672
RABBITMQ_USER=chathub
RABBITMQ_PASSWORD=replace-me
# MESSAGING_ENABLED=false stops the api from writing outbox rows and publishing (RabbitMQ still starts).
# MESSAGING_ENABLED=true

# With Redis configured, each replica refreshes a heartbeat; a replica silent for InstanceTimeoutSeconds is treated
# as crashed and its users' connections are removed (they go offline unless connected elsewhere).
# RealTime__HeartbeatIntervalSeconds=5
# RealTime__InstanceTimeoutSeconds=15
