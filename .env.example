# Copy to .env (gitignored, never commit it) and replace every placeholder.
# Secrets must be at least 32 bytes. Generate a fresh one per variable with:
#   openssl rand -base64 48
# The placeholders below are deliberately too short, so the API refuses to start until they are replaced.

ASPNETCORE_ENVIRONMENT=Production

# PostgreSQL. docker-compose builds ConnectionStrings__DefaultConnection for the migrator and the api from these.
POSTGRES_DB=chathub
POSTGRES_USER=chathub
POSTGRES_PASSWORD=replace-me

# Connection budget: api replicas × DB_MAX_POOL_SIZE + NOTIFICATIONS_DB_MAX_POOL_SIZE + headroom (migrators, seeder, psql)
# <= POSTGRES_MAX_CONNECTIONS.
# DB_MAX_AUTO_PREPARE=0 turns Npgsql's automatic statement preparation off. See docs/PERFORMANCE.md.
# POSTGRES_MAX_CONNECTIONS=100
# DB_MAX_POOL_SIZE=30
# DB_MAX_AUTO_PREPARE=50

Jwt__Secret=replace-me
FileStorage__SigningKey=replace-me

# Public address of the API (nginx) as users reach it. Verification and unsubscribe links in emails start with it,
# so in production it must be the real https origin, e.g. https://api.chat.example.com. The seeder's
# --backfill-notifications uses it too. Default: http://localhost:8080
# PUBLIC_API_BASE_URL=http://localhost:8080
# Email verification: how long a link works, and how many verification emails one user may request per hour
# (registration counts as one). POST /api/auth/email-verification is also limited per IP (RateLimiting__EmailVerificationPermitLimit).
# EMAIL_VERIFICATION_TOKEN_LIFETIME_HOURS=24
# EMAIL_VERIFICATION_MAX_REQUESTS_PER_HOUR=3
# Per-IP limits (per minute) for requesting verification emails and for opening verification / unsubscribe links.
# RateLimiting__EmailVerificationPermitLimit=5
# RateLimiting__EmailLinkPermitLimit=30

# The web client. Password reset emails link to {FRONTEND_BASE_URL}/reset-password?token=..., a page the client hosts
# (it posts the token and the new password to POST /api/auth/reset-password). Keep it equal to NOTIFICATIONS_APP_BASE_URL.
# Default: http://localhost:3000
# FRONTEND_BASE_URL=http://localhost:3000
# Password reset: how long a link works (minutes) and how many reset emails one account may get per hour.
# POST /api/auth/forgot-password always answers 202 after at least PasswordReset__MinimumResponseMilliseconds (300),
# and is limited per IP (RateLimiting__PasswordResetPermitLimit, 5 a minute).
# PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
# PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
# PasswordReset__MinimumResponseMilliseconds=300
# RateLimiting__PasswordResetPermitLimit=5
# Days between two username changes (0 = no limit), and the per-IP limit of the username availability check.
# USERNAME_CHANGE_COOLDOWN_DAYS=14
# RateLimiting__UsernameCheckPermitLimit=30

# Browser origins allowed to call the API. Add more with __1, __2, ...
Cors__AllowedOrigins__0=https://chat.example.com

# docker-compose runs two API replicas behind nginx on a network with a fixed subnet and sets
# ForwardedHeaders__KnownNetworks__0 to that subnet itself, so the API trusts nginx's X-Forwarded-For and the
# per-IP rate limiter sees real client addresses. Change the subnet only if it collides with another Docker network.
# CHATHUB_SUBNET=172.29.0.0/24

# Further reverse proxies whose X-Forwarded-For / X-Forwarded-Proto headers are trusted. Empty = trust none (loopback only).
# Use the proxy's IP (KnownProxies) or its network in CIDR form (KnownNetworks). Add more with __1, __2, ...
# Under docker-compose KnownNetworks__0 is the compose subnet, so further networks start at __1.
ForwardedHeaders__KnownProxies__0=
ForwardedHeaders__KnownNetworks__1=

# RabbitMQ receives the integration events the api writes to its transactional outbox (see docs/MESSAGING.md).
# docker-compose creates the broker user from these on the first start of an empty chathub-rabbitmq volume and passes
# them to the api as Messaging__User / Messaging__Password; changing them later needs `docker compose down -v` or rabbitmqctl.
# Defaults: chathub / chathub. Management UI: http://127.0.0.1:15672
RABBITMQ_USER=chathub
RABBITMQ_PASSWORD=replace-me
# MESSAGING_ENABLED=false stops the api from writing outbox rows and publishing (RabbitMQ still starts).
# MESSAGING_ENABLED=true

# Notification service (see docs/NOTIFICATIONS.md): consumes those events and emails digests of unread messages.
# By default it sends to Mailpit, which keeps every email locally: http://127.0.0.1:8025
# For a real relay set the SMTP_* values, e.g. Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURITY=StartTls,
# SMTP_USER=<your Brevo login>, SMTP_PASSWORD=<an SMTP key>, SMTP_FROM_ADDRESS=<a sender verified in Brevo>.
# SMTP_SECURITY is None, StartTls, SslOnConnect or Auto.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURITY=None
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=notifications@chathub.local
# SMTP_FROM_NAME=ChatHub
# Wait this long after the first unread message before emailing (15 is handy for a demo), then at least the cooldown
# between two emails for the same conversation. Links in the emails start with NOTIFICATIONS_APP_BASE_URL.
# NOTIFICATIONS_DIGEST_DELAY_SECONDS=120
# NOTIFICATIONS_COOLDOWN_MINUTES=15
# NOTIFICATIONS_INCLUDE_PREVIEW=true
# NOTIFICATIONS_APP_BASE_URL=http://localhost:3000
# Sending limits per worker (see docs/NOTIFICATIONS.md#sending-limits). Brevo's free tier allows 300 emails a day; the
# defaults stay below it and keep 50 a day and 5 a minute for verification emails, which always go first.
# Digests to one person are capped per hour across conversations.
# NOTIFICATIONS_MAX_EMAILS_PER_MINUTE=20
# NOTIFICATIONS_MAX_DIGESTS_PER_MINUTE=15
# NOTIFICATIONS_MAX_EMAILS_PER_DAY=250
# NOTIFICATIONS_MAX_DIGESTS_PER_DAY=200
# NOTIFICATIONS_MAX_EMAILS_PER_RECIPIENT_PER_HOUR=4
# How often a digest held for a recipient who is online or not verified yet is checked again (lower it for demos).
# NOTIFICATIONS_HOLD_RECHECK_SECONDS=60
# The worker's own environment. Production (default) never emails reserved domains (.test, .example, .invalid,
# .localhost, example.com/.net/.org), because bounces hurt the sender's reputation. Development allows them, so seeded
# @chathub.test users' mail shows up in Mailpit (load tests, demos).
# NOTIFICATIONS_ENVIRONMENT=Production
# The service's own database on the same PostgreSQL server (created by notifications-migrator) and its pool size.
# NOTIFICATIONS_DB=chathub_notifications
# NOTIFICATIONS_DB_MAX_POOL_SIZE=5

# With Redis configured, each replica refreshes a heartbeat; a replica silent for InstanceTimeoutSeconds is treated
# as crashed and its users' connections are removed (they go offline unless connected elsewhere).
# RealTime__HeartbeatIntervalSeconds=5
# RealTime__InstanceTimeoutSeconds=15
