# Production settings for docker-compose.prod.yml (docs/DEPLOYMENT.md).
# Copy to .env.prod on the server, replace every "replace-me", and keep it private: chmod 600 .env.prod.
# .env.prod is gitignored; never commit it. Values must not contain spaces or quotes.

# ---- Images ------------------------------------------------------------------------------------------------------
# Registry and lower-case owner of the images CI pushes (ghcr.io/<owner>/chathub-*).
CHATHUB_IMAGE_PREFIX=ghcr.io/m7mhm
# Tag used by a plain "deploy/compose.sh up -d". deploy/deploy.sh <tag> overrides it and remembers the deployed tag
# in deploy/.state, so leave this at "latest" and deploy short commit SHAs.
CHATHUB_TAG=latest

# ---- Public addresses ---------------------------------------------------------------------------------------------
# Hostname of the API without scheme; must equal CHATHUB_HOST in deploy/edge/.env. Links in verification and
# unsubscribe emails start with https://<this>.
CHATHUB_HOST=chathub-api.duckdns.org
# Origin of the Next.js frontend on Vercel (scheme + host, no path, no trailing slash). It is the only browser origin
# CORS allows, and links in digest emails open it.
FRONTEND_ORIGIN=https://chathub.vercel.app
# Optional second allowed origin, e.g. a custom frontend domain. Leave empty if unused.
FRONTEND_EXTRA_ORIGIN=

# ---- Secrets -----------------------------------------------------------------------------------------------------
# Generate each with: openssl rand -base64 48   (64 characters; the API refuses to start below 32 bytes)
# JWT signing key. Changing it signs every user out.
JWT_SECRET=replace-me
# Key that signs file download URLs. Changing it invalidates links already handed out.
FILE_SIGNING_KEY=replace-me
# PostgreSQL superuser of this stack. Generate with: openssl rand -hex 24  (hex avoids characters that break the
# connection string). The password is set when the data volume is created; changing it later needs ALTER ROLE.
POSTGRES_PASSWORD=replace-me
# RabbitMQ user for the API and the worker. Generate with: openssl rand -hex 24. Set on the first start of an empty
# rabbitmq volume; changing it later needs rabbitmqctl change_password.
RABBITMQ_PASSWORD=replace-me

# ---- Email (Brevo SMTP relay, free tier: 300 emails a day) -----------------------------------------------------------
# From Brevo: Settings > SMTP & API > SMTP. The login looks like 1a2b3c001@smtp-brevo.com; the password is an SMTP key
# (not your account password and not an API key).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USER=replace-me@smtp-brevo.com
SMTP_PASSWORD=replace-me
# Sender: a single sender or an address on a domain verified in Brevo (Senders, domains & dedicated IPs).
SMTP_FROM_ADDRESS=notifications@example.com
SMTP_FROM_NAME=ChatHub

# ---- Capacity (see docs/DEPLOYMENT.md#memory-budget) ---------------------------------------------------------------
# API replicas. 1 fits next to another project on a 2 GB droplet; 2 doubles the API's memory. A deploy briefly runs
# one more while it replaces them.
API_REPLICAS=1
# Connections per API replica. Budget: (API_REPLICAS + 1) x DB_MAX_POOL_SIZE + NOTIFICATIONS_DB_MAX_POOL_SIZE + 5
# (migrators, backups, psql) must stay below POSTGRES_MAX_CONNECTIONS.
DB_MAX_POOL_SIZE=10
NOTIFICATIONS_DB_MAX_POOL_SIZE=5
POSTGRES_MAX_CONNECTIONS=50

# ---- Optional ------------------------------------------------------------------------------------------------------
# Database names and users. Changing them after the first start needs a manual migration of the data.
POSTGRES_DB=chathub
POSTGRES_USER=chathub
NOTIFICATIONS_DB=chathub_notifications
RABBITMQ_USER=chathub
# "true" maps the OpenAPI document and the Scalar UI (/openapi/v1.json, /scalar). Also set CHATHUB_DOCS_PUBLIC=true
# in deploy/edge/.env, or Caddy keeps answering 404 for them.
CHATHUB_DOCS_PUBLIC=false
# Must equal EDGE_PROXY_IP in deploy/edge/.env: the only address whose X-Forwarded-For the API trusts.
EDGE_PROXY_IP=172.31.0.2
# "true" adds an X-Instance-Id response header naming the replica that answered (handy while testing a deploy).
EXPOSE_INSTANCE_ID=false
# Login/registration attempts per minute and client IP (default 10).
RATE_LIMIT_AUTH_STRICT=10
# Email verification links expire after this many hours; a user may request this many per hour.
EMAIL_VERIFICATION_TOKEN_LIFETIME_HOURS=24
EMAIL_VERIFICATION_MAX_REQUESTS_PER_HOUR=3
# Password reset links open FRONTEND_ORIGIN/reset-password?token=... and expire after this many minutes;
# an account gets at most this many reset emails per hour.
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=30
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=3
# Days between two username changes (0 = no limit).
USERNAME_CHANGE_COOLDOWN_DAYS=14
# "Continue as guest": false answers 404. Guests and their demo chats are deleted after GUEST_LIFETIME_HOURS.
# GUEST_MAX_ACTIVE caps live guests (each costs ~30 rows); one IP may create GUEST_CREATE_PER_IP_PER_HOUR an hour.
GUEST_ENABLED=true
GUEST_LIFETIME_HOURS=24
GUEST_MAX_ACTIVE=500
GUEST_CREATE_PER_IP_PER_HOUR=5
# ChatHub Bot's canned replies (typing, then a reply after ~1.5 s).
BOT_ENABLED=true
# Digest emails: wait this long after the first unread message, then at least the cooldown per conversation.
NOTIFICATIONS_DIGEST_DELAY_SECONDS=120
NOTIFICATIONS_COOLDOWN_MINUTES=15
NOTIFICATIONS_INCLUDE_PREVIEW=true
# Sending limits, sized for Brevo's 300 a day (docs/NOTIFICATIONS.md#sending-limits).
NOTIFICATIONS_MAX_EMAILS_PER_MINUTE=20
NOTIFICATIONS_MAX_DIGESTS_PER_MINUTE=15
NOTIFICATIONS_MAX_EMAILS_PER_DAY=250
NOTIFICATIONS_MAX_DIGESTS_PER_DAY=200
NOTIFICATIONS_MAX_EMAILS_PER_RECIPIENT_PER_HOUR=4

# ---- Deploy scripts --------------------------------------------------------------------------------------------------
# Where deploy/backup.sh writes dumps (created by the setup steps in docs/DEPLOYMENT.md).
BACKUP_DIR=/var/backups/chathub
# Name of the Caddy container that deploy/deploy.sh reloads after changing the API upstream list.
EDGE_CONTAINER=edge-caddy-1
