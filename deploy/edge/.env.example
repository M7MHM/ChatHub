# Edge proxy (Caddy) settings. Copy to deploy/edge/.env on the server (gitignored) and fill in.
# Start it before any app stack: docker compose -f deploy/edge/compose.yml --env-file deploy/edge/.env up -d

# Let's Encrypt account email: expiry warnings and account recovery go here.
ACME_EMAIL=you@example.com

# Public hostname of the ChatHub API, without scheme. Must resolve to the droplet (A record) before Caddy starts,
# or certificate issuance fails and is retried with backoff. Examples: chathub-api.duckdns.org,
# 203-0-113-10.sslip.io, api.chat.example.com
CHATHUB_HOST=chathub-api.duckdns.org

# "true" also serves the OpenAPI document and the Scalar UI publicly. Set OpenApi__Enabled the same way in .env.prod.
CHATHUB_DOCS_PUBLIC=false

# Hostname of ParkingService once its block in the Caddyfile is uncommented.
PARKING_HOST=

# Leave empty in production. "local_certs" makes Caddy issue every certificate from its own internal CA (used by the
# local rehearsal, where no public DNS name exists).
EDGE_LOCAL_CERTS=

# Host ports. Keep 80 and 443 on the server: Let's Encrypt validates on port 80 (HTTP-01) or 443 (TLS-ALPN-01).
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# The shared "edge" Docker network. Caddy gets a fixed address outside the range Docker hands out, and the API trusts
# X-Forwarded-For only from that address (EDGE_PROXY_IP in .env.prod must match). Change the subnet only if it
# collides with another network on the server.
EDGE_SUBNET=172.31.0.0/24
EDGE_IP_RANGE=172.31.0.128/25
EDGE_PROXY_IP=172.31.0.2
